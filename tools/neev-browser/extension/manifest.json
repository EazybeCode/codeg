{
  "manifest_version": 3,
  "name": "Neev Browser",
  "version": "0.2.1",
  "description": "Drive one tab you pick with your locally installed Claude Code or Codex CLI, and return Neev agent sign-ins from your browser.",
  "permissions": [
    "sidePanel",
    "scripting",
    "nativeMessaging",
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "storage"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Neev Browser"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://app.neev.so/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.neev.so/*"
      ],
      "js": [
        "content/signin-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
