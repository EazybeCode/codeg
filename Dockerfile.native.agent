# Agent-capable Neev native image — the isolated runtime variant that can run the
# sandboxed personal-agent runtime. Built ON TOP of the reviewed base image
# (Dockerfile.native), adding only what the sandbox launcher needs:
#   * python3            — runs scripts/operations/neev_agent_launch.py + sandbox
#   * python-is-python3  — `python` is what an agent actually types
#   * python3-bs4        — HTML parsing, the common reason it reaches for python
#
#   * Node.js + npm     — JavaScript/HTML tooling inside agent runs
#   * util-linux         — unshare / setpriv / prlimit (namespaces, uid drop, rlimits)
#   * iproute2, nftables — ip / nft (per-tenant egress netns + default-deny firewall)
#   * the launcher + sandbox + egress scripts at NEEV_AGENT_LAUNCHER
#
# Defaults stay FAIL-CLOSED and non-root (NEEV_RUNTIME_ENABLED unset, USER 65532):
# this image only *enables* the runtime when the deployment sets
# NEEV_RUNTIME_ENABLED=true with the reviewed file-capability helper profile,
# provisioned login-isolation slot bridges/proxies, and per-user provider
# credentials. The web server remains USER 65532; do not run it as root.
#
# Build (two-step; base first):
#   docker build -f Dockerfile.native       -t neev-native:<tag>       .
#   docker build -f Dockerfile.native.agent -t neev-native-agent:<tag> \
#     --build-arg BASE_IMAGE=neev-native:<tag> .

ARG BASE_IMAGE=neev-native:latest
FROM ${BASE_IMAGE} AS agent

USER 0:0
# Pinned official native CLI; provider credentials are supplied per user at run
# time, never baked into this image. Update version and checksum together.
ADD --checksum=sha256:0399c793ff571d5946ef923d80b4f330d05ac4b6842a6b0775468f5d389403c0 \
    --chmod=0555 \
    https://downloads.claude.ai/claude-code-releases/2.1.267/linux-x64/claude \
    /usr/local/bin/claude
RUN /usr/local/bin/claude --version
# Keep the official package layout so Codex can locate its bundled helpers.
ADD --checksum=sha256:a65b895c6ac1a73629bbe4b864640c86133e94a43b4d67b3103044e1a306d5a2 \
    https://github.com/openai/codex/releases/download/rust-v0.155.1/codex-package-x86_64-unknown-linux-musl.tar.gz \
    /tmp/neev-codex-package.tar.gz
RUN install -d -o 0 -g 0 -m 0755 /opt/neev/codex \
    && tar -xzf /tmp/neev-codex-package.tar.gz -C /opt/neev/codex \
    && rm /tmp/neev-codex-package.tar.gz \
    && ln -s /opt/neev/codex/bin/codex /usr/local/bin/codex \
    && /usr/local/bin/codex --version
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      python3 \
      # `python3` alone is not what anything actually types. An agent asked to
      # pull apart an HTML attachment reaches for `python` and gets
      # "command not found" — observed in a real turn, which then cost a second
      # failed attempt looking for node before it fell back to `rg`. This is the
      # distro's own symlink package, nothing more.
      python-is-python3 \
      # BeautifulSoup, because parsing the HTML was the actual task and the
      # interpreter alone would only move the failure from "no python" to "no
      # module". Distro-packaged rather than pip-installed so the image stays
      # reproducible and no build toolchain is pulled in.
      python3-bs4 \
      util-linux \
      cryptsetup-bin \
      e2fsprogs \
      iproute2 \
      nftables \
      libcap2-bin \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o 0 -g 0 -m 0755 /opt/neev/scripts/operations \
    # Lanes need search access to their own absolute HOME below this directory.
    # They cannot list it; each run directory remains private at mode 0700.
    && install -d -o 65532 -g 65532 -m 0711 /data/agents

# Official Node LTS distribution, pinned to its published SHA-256. Keep npm
# with Node so agents can inspect package availability without a missing binary.
ADD --checksum=sha256:1084aa36196bba4c3a5e69a1ee388a6e4ff729dad09445fbcd434b28fe3c24af \
    https://nodejs.org/dist/v22.23.3/node-v22.23.3-linux-x64.tar.gz \
    /tmp/neev-node.tar.gz
RUN install -d -o 0 -g 0 -m 0755 /opt/neev/node \
    && tar -xzf /tmp/neev-node.tar.gz --strip-components=1 -C /opt/neev/node \
       node-v22.23.3-linux-x64/bin node-v22.23.3-linux-x64/lib node-v22.23.3-linux-x64/LICENSE \
    && rm /tmp/neev-node.tar.gz \
    && ln -s /opt/neev/node/bin/node /usr/local/bin/node \
    && ln -s /opt/neev/node/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /opt/neev/node/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && node --version && npm --version

# Grant the FIXED-command launch helper exactly the caps the sandbox setup needs
# (and no more): chown the per-run workdir, drop to the tenant uid/gid, drop the
# bounding set, create namespaces, wire the egress netns/nft, mkdir under /run,
# and terminate the uid-dropped child on cancellation (CAP_KILL).
# The web server (uid 65532) has NO effective caps; it execs this helper, which
# raises these to the ambient set and execs the launcher. libcap2-bin is only a
# build-time tool for setcap (the xattr persists in the layer).
RUN setcap 'cap_chown,cap_dac_override,cap_kill,cap_setgid,cap_setuid,cap_setpcap,cap_net_admin,cap_sys_admin,cap_mknod=eip' \
      /usr/local/bin/neev-agent-caplaunch \
    && getcap /usr/local/bin/neev-agent-caplaunch \
    # The deploy runs with no-new-privileges:false so the helper's FILE CAPS take
    # effect. That would also re-enable setuid-root binaries (su/mount/umount from
    # util-linux) as an escalation path for an RCE as uid 65532 — so strip every
    # setuid/setgid bit. This does NOT touch the helper's capability xattrs (file
    # caps are not the setuid mode bit), and the launcher uses non-setuid
    # unshare/setpriv/prlimit/ip/nft via the ambient caps.
    && { find / -xdev -perm /6000 -type f -exec chmod -s {} + 2>/dev/null || true; } \
    # ASSERT (fail the build, not just display): the ONLY file-capped binary is the
    # helper, and NO setuid/setgid binary remains. With no-new-privileges:false at
    # deploy, either would be a direct escalation path for uid 65532.
    && test -z "$(getcap -r / 2>/dev/null | grep -v '^/usr/local/bin/neev-agent-caplaunch ')" \
    && test -z "$(find / -xdev -perm /6000 -type f 2>/dev/null)" \
    && echo "cap/setuid assertions passed"
# libcap2-bin (setcap/getcap) is intentionally KEPT: purging it cascades and
# removes iproute2 (which the launcher needs for /usr/sbin/ip), and setcap is
# harmless at runtime — it requires CAP_SETFCAP, which no process in the container
# holds (not in the cap_add set, and uid 65532 has no caps).

# The launcher composes the sandbox + provider-egress; ship the whole operations
# set it imports (sandbox, egress, login profile, codex login egress).
COPY --chown=0:0 scripts/operations/neev_agent_launch.py \
     scripts/operations/neev_codex_stream_adapter.py \
     scripts/operations/neev_agent_sandbox.py \
     scripts/operations/neev_agent_ns_prelude.py \
     scripts/operations/neev_agent_credentials.py \
     scripts/operations/neev_credential_store.py \
     scripts/operations/neev_credential_volumes.py \
     scripts/operations/neev_agent_egress.py \
     scripts/operations/neev_login_network_profile.py \
     scripts/operations/neev_codex_login_egress.py \
     scripts/operations/neev_provider_endpoints.py \
     scripts/operations/neev_provider_egress.py \
     scripts/operations/neev_claude_login_protocol.py \
     scripts/operations/neev_codex_login_protocol.py \
     scripts/operations/neev_agent_network_bootstrap.py \
     scripts/operations/neev_agent_supervisor.py \
     scripts/operations/neev_agent_login_drivers.py \
     scripts/operations/neev_agent_supervisor_main.py \
     scripts/operations/neev_agent_container_init.py \
     scripts/operations/neev_supervisor_dto.py \
     scripts/operations/neev_supervisor_fence.py \
     scripts/operations/neev_supervisor_transport.py \
     scripts/operations/neev_supervisor_wire.py \
     scripts/operations/neev_supervisor_deployment.py \
     scripts/operations/neev_slot_proxy.py \
     /opt/neev/scripts/operations/
RUN chmod 0555 /opt/neev/scripts/operations/*.py
# The shared response-style policy the launcher carries into each paid turn.
# Data, not code: root-owned and world-READABLE only, beside the launcher that
# is the only thing allowed to load it.
COPY --chown=0:0 scripts/operations/neev_response_style.md \
     /opt/neev/scripts/operations/
RUN chmod 0444 /opt/neev/scripts/operations/neev_response_style.md

ENV NEEV_AGENT_LAUNCHER=/opt/neev/scripts/operations/neev_agent_launch.py \
    NEEV_AGENT_CAP_HELPER=/usr/local/bin/neev-agent-caplaunch \
    NEEV_AGENT_WORKSPACE_ROOT=/data/agents \
    NEEV_AGENT_BINARY=/usr/local/bin/claude \
    NEEV_AGENT_CODEX_BINARY=/usr/local/bin/codex

# Codex turns run through the in-sandbox app-server adapter, which streams the
# reply as it is written; `codex exec --json` has no token-level output and
# delivers it whole after the turn is over. Rollback is this value set to `exec`
# (or removed) plus a restart: the launcher's own default is still `exec`, so
# this line is the only thing selecting the new transport.
ENV NEEV_CODEX_STREAM=app-server

# Fail-closed defaults preserved: runtime OFF, non-root. Enabling is a deploy-time
# decision (see NEEV-PRODUCTION-RELEASE-RUNBOOK.md STEP 3/4): set
# NEEV_RUNTIME_ENABLED=true with the scoped helper capabilities, provision the
# slot bridges/proxies, and connect each user through the supported provider flow.
# A shared host provider login is not supported; keep the server non-root.
USER 65532:65532
STOPSIGNAL SIGINT
CMD ["/usr/local/bin/neev-server"]
