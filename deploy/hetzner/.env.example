# Copy to .env and fill in.  One .env = one org.
ORG_SLUG=eazybe
DOMAIN=workos.eazybe.com                 # DNS A record must point at the server IP

# Strong access token (NOT eazybe-dev). Generate:  openssl rand -hex 24
CODEG_TOKEN=

# Agent credentials (org-owned, so server-side Claude/Codex work):
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
OPENAI_API_KEY=

# Repos the org's agents can work on (mounted at /projects in the container):
PROJECTS_DIR=./projects

# Optional extra HTTP basic-auth in front (see Caddyfile):
BASIC_USER=
BASIC_HASH=

# Optional git creds for pushing the org-memory wiki:
CODEG_GIT_USERNAME=
CODEG_GIT_PASSWORD=

IMAGE_TAG=latest
