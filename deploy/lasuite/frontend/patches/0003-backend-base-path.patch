+ * media URLs in doc-editor/hook/useUploadFile.
+ *
+ * @returns The backend base URL as a string, with no trailing slash.
+ */
+export const backendUrl = () =>
+  `${backendOrigin()}${process.env.NEXT_PUBLIC_BACKEND_BASE_PATH || ''}`;
