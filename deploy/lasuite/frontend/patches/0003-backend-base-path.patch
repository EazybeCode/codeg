+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+
+import { backendOrigin, backendUrl, baseApiUrl } from '@/api';
+
+/**
+ * The backend is not always mounted at the root. When Docs is embedded in a
+ * host application it is reverse-proxied under a path prefix, and every
+ * backend-facing URL — REST, media, the collaboration socket — has to carry it.
+ *
+ * The prefix deliberately lives in its own variable rather than being folded
+ * into NEXT_PUBLIC_API_ORIGIN, so the origin stays derived from the page at
+ * runtime and a single build serves any host.
+ *
+ * `.env.test` sets NEXT_PUBLIC_API_ORIGIN=http://test.jest, which these tests
+ * restore rather than assume.
+ */
+describe('backend base path', () => {
+  const originalOrigin = process.env.NEXT_PUBLIC_API_ORIGIN;
+  const originalBasePath = process.env.NEXT_PUBLIC_BACKEND_BASE_PATH;
+
+  beforeEach(() => {
+    delete process.env.NEXT_PUBLIC_BACKEND_BASE_PATH;
+  });
+
+  afterEach(() => {
+    process.env.NEXT_PUBLIC_API_ORIGIN = originalOrigin;
+    process.env.NEXT_PUBLIC_BACKEND_BASE_PATH = originalBasePath;
+  });
+
+  it('is upstream behaviour when no prefix is set', () => {
+    expect(backendUrl()).toBe('http://test.jest');
+    expect(baseApiUrl()).toBe('http://test.jest/api/v1.0/');
+  });
+
+  it('appends the prefix to the configured origin', () => {
+    process.env.NEXT_PUBLIC_BACKEND_BASE_PATH = '/document-engine';
+
+    expect(backendOrigin()).toBe('http://test.jest');
+    expect(backendUrl()).toBe('http://test.jest/document-engine');
+    expect(baseApiUrl()).toBe('http://test.jest/document-engine/api/v1.0/');
+  });
+
+  /**
+   * The embedded build ships with no origin configured, so it is taken from the
+   * page. This is what lets the same artifact serve production HTTPS and a
+   * loopback test without a rebuild.
+   */
+  it('appends the prefix to the runtime origin when none is configured', () => {
+    delete process.env.NEXT_PUBLIC_API_ORIGIN;
+    process.env.NEXT_PUBLIC_BACKEND_BASE_PATH = '/document-engine';
+
+    expect(backendOrigin()).toBe(window.location.origin);
+    expect(baseApiUrl()).toBe(
+      `${window.location.origin}/document-engine/api/v1.0/`,
+    );
+  });
+
+  it('keeps the prefix on non-default API versions', () => {
+    process.env.NEXT_PUBLIC_BACKEND_BASE_PATH = '/document-engine';
+
+    expect(baseApiUrl('2.0')).toBe(
+      'http://test.jest/document-engine/api/v2.0/',
+    );
+  });
+
+  /**
+   * Media URLs are composed as `${backendUrl()}${attachment.file}`, where the
+   * backend returns `file` as a root-relative `/media/...` path. The prefix has
+   * to come from this side, which also means the backend must not add it.
+   */
+  it('produces prefixed media URLs from an unprefixed backend path', () => {
+    process.env.NEXT_PUBLIC_BACKEND_BASE_PATH = '/document-engine';
+
+    expect(`${backendUrl()}/media/doc-id/attachment.png`).toBe(
+      'http://test.jest/document-engine/media/doc-id/attachment.png',
+    );
+  });
+});
