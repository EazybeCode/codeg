+  /**
+   * The host application renamed this document from its own chrome.
+   *
+   * Embedded, Neev owns a tab, a breadcrumb and a sidebar that all show this
+   * title, and it can be renamed from any of them. That write goes to the
+   * server rather than through this page, so the editor would go on showing
+   * the name it read when it booted until something reloaded it.
+   *
+   * Re-reading one query is the whole response. Reloading the frame also works
+   * and was what the host did first — it also throws away whatever is being
+   * typed at that moment, which is too much to spend on a name. Nothing here
+   * touches the Y.Doc, the provider, or the editor's state.
+   *
+   * Three checks before it counts, and the message is a nudge rather than a
+   * fact — no title is read from it, the API is asked instead:
+   *
+   * - `event.origin` must be this page's own origin. The embed is same-origin
+   *   by design, so anything else is not the host.
+   * - `event.source` must be the parent window specifically, not merely some
+   *   window — another frame on the host page must not be able to drive this.
+   * - the id must be the document actually open here.
+   */
+  useEffect(() => {
+    if (!isEmbedded() || !room || window.parent === window) {
+      return;
+    }
+
+    const onMessage = (event: MessageEvent) => {
+      if (event.origin !== window.location.origin) {
+        return;
+      }
+      if (event.source !== window.parent) {
+        return;
+      }
+      const data = event.data as {
+        type?: unknown;
+        resourceId?: unknown;
+      } | null;
+      if (!data || data.type !== HOST_REFRESH_EVENT) {
+        return;
+      }
+      if (data.resourceId !== room) {
+        return;
+      }
+
+      void queryClient.invalidateQueries({
+        queryKey: [KEY_DOC, { id: room }],
+      });
+    };
+
+    window.addEventListener('message', onMessage);
+    // Announced only once the listener is actually attached, so a refresh the
+    // host held while this page was booting is flushed to a window that can
+    // receive it.
+    notifyHostFrameReady(room);
+    return () => window.removeEventListener('message', onMessage);
+  }, [room, queryClient]);
