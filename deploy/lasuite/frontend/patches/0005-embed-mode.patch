@@ -0,0 +1,16 @@
+/**
+ * Embedded mode.
+ *
+ * Docs can be built as a standalone product (upstream's default) or embedded in
+ * a host application that already provides navigation, document listing,
+ * identity and sharing — in which case rendering Docs' own chrome would
+ * duplicate all of it.
+ *
+ * Embedded mode removes presentation only. It hides controls; it never decides
+ * what a user may do. Every affected action is still authorised server-side, so
+ * a hidden button is not a permission boundary and must not be read as one.
+ *
+ * `NEXT_PUBLIC_EMBED` is inlined by Next at build time, so this collapses to a
+ * constant and the hidden branches are eliminated from the bundle.
+ */
+export const isEmbedded = () => process.env.NEXT_PUBLIC_EMBED === 'true';
