diff --git a/apps/impress/src/layouts/__tests__/MainLayoutEmbed.test.tsx b/apps/impress/src/layouts/__tests__/MainLayoutEmbed.test.tsx
new file mode 100644
index 0000000..dcb8725
--- /dev/null
+++ b/apps/impress/src/layouts/__tests__/MainLayoutEmbed.test.tsx
@@ -0,0 +1,81 @@
+import { render, screen } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { MainLayoutContent } from '../MainLayout';
+
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({ t: (key: string) => key }),
+}));
+
+vi.mock('@/features/left-panel', () => ({
+  LeftPanel: () => <nav data-testid="left-panel" />,
+  ResizableLeftPanel: ({ children }: { children: React.ReactNode }) => (
+    <div data-testid="resizable-left-panel">{children}</div>
+  ),
+}));
+
+vi.mock('@/features/right-panel/components/RightPanel', () => ({
+  RightPanel: () => <aside data-testid="right-panel" />,
+}));
+
+vi.mock('@/features/skeletons', () => ({
+  Skeleton: () => null,
+  DocEditorSkeleton: () => null,
+}));
+
+/**
+ * Embedded, the host application already provides document navigation, so
+ * rendering Docs' own left panel would duplicate it. The right panel is a
+ * different thing — comments and the table of contents belong to the document
+ * being edited — and stays.
+ */
+describe('MainLayoutContent when embedded', () => {
+  const original = process.env.NEXT_PUBLIC_EMBED;
+
+  beforeEach(() => {
+    delete process.env.NEXT_PUBLIC_EMBED;
+  });
+
+  afterEach(() => {
+    process.env.NEXT_PUBLIC_EMBED = original;
+  });
+
+  it('renders the left panel when not embedded', () => {
+    render(
+      <MainLayoutContent enableResizablePanel={false}>
+        <p>document</p>
+      </MainLayoutContent>,
+    );
+
+    expect(screen.getByTestId('left-panel')).toBeInTheDocument();
+    expect(screen.getByText('document')).toBeInTheDocument();
+  });
+
+  it('drops the left panel and its resizer when embedded', () => {
+    process.env.NEXT_PUBLIC_EMBED = 'true';
+
+    render(
+      <MainLayoutContent enableResizablePanel={true}>
+        <p>document</p>
+      </MainLayoutContent>,
+    );
+
+    expect(screen.queryByTestId('left-panel')).not.toBeInTheDocument();
+    expect(
+      screen.queryByTestId('resizable-left-panel'),
+    ).not.toBeInTheDocument();
+    expect(screen.getByText('document')).toBeInTheDocument();
+  });
+
+  it('keeps the right panel when embedded', () => {
+    process.env.NEXT_PUBLIC_EMBED = 'true';
+
+    render(
+      <MainLayoutContent enableResizablePanel={true}>
+        <p>document</p>
+      </MainLayoutContent>,
+    );
+
+    expect(screen.getByTestId('right-panel')).toBeInTheDocument();
+  });
+});
