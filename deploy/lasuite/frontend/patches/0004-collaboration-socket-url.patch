+import { renderHook } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { useCollaborationUrl } from '../useCollaborationUrl';
+
+const useConfig = vi.hoisted(() => vi.fn());
+
+vi.mock('../../api', () => ({ useConfig }));
+
+const ROOM = '11111111-1111-4111-8111-111111111111';
+
+const setLocation = (href: string) => {
+  window.history.replaceState({}, '', '/');
+  Object.defineProperty(window, 'location', {
+    configurable: true,
+    value: new URL(href),
+  });
+};
+
+/**
+ * Upstream's fallback hardcodes `wss://` and the root `/collaboration/ws/`.
+ * Neither holds once Docs is embedded behind a proxy prefix, and the hardcoded
+ * scheme also makes the socket unreachable over a plain-HTTP loopback
+ * deployment. A backend-supplied COLLABORATION_WS_URL must still win, because
+ * that is how a separately-hosted collaboration service is pointed at.
+ */
+describe('useCollaborationUrl', () => {
+  const originalLocation = window.location;
+  const originalBasePath = process.env.NEXT_PUBLIC_BACKEND_BASE_PATH;
+
+  beforeEach(() => {
+    useConfig.mockReturnValue({ data: undefined });
+    delete process.env.NEXT_PUBLIC_BACKEND_BASE_PATH;
+  });
+
+  afterEach(() => {
+    Object.defineProperty(window, 'location', {
+      configurable: true,
+      value: originalLocation,
+    });
+    process.env.NEXT_PUBLIC_BACKEND_BASE_PATH = originalBasePath;
+    vi.clearAllMocks();
+  });
+
+  it('returns nothing without a room', () => {
+    const { result } = renderHook(() => useCollaborationUrl(undefined));
+
+    expect(result.current).toBeUndefined();
+  });
+
+  it('is upstream behaviour on https with no prefix set', () => {
+    setLocation('https://docs.example.com/docs/abc/');
+
+    const { result } = renderHook(() => useCollaborationUrl(ROOM));
+
+    expect(result.current).toBe(
+      `wss://docs.example.com/collaboration/ws/?room=${ROOM}`,
+    );
+  });
+
+  it('carries the prefix the backend is proxied under', () => {
+    process.env.NEXT_PUBLIC_BACKEND_BASE_PATH = '/document-engine';
+    setLocation('https://neev.example.com/document-engine/docs/abc/');
+
+    const { result } = renderHook(() => useCollaborationUrl(ROOM));
+
+    expect(result.current).toBe(
+      `wss://neev.example.com/document-engine/collaboration/ws/?room=${ROOM}`,
+    );
+  });
+
+  /**
+   * The loopback case: a plain-HTTP page cannot open a `wss:` socket to itself.
+   */
+  it('follows the page scheme so http deployments can connect', () => {
+    process.env.NEXT_PUBLIC_BACKEND_BASE_PATH = '/document-engine';
+    setLocation('http://localhost:8100/document-engine/docs/abc/');
+
+    const { result } = renderHook(() => useCollaborationUrl(ROOM));
+
+    expect(result.current).toBe(
+      `ws://localhost:8100/document-engine/collaboration/ws/?room=${ROOM}`,
+    );
+  });
+
+  it('lets a backend-supplied URL win over the fallback', () => {
+    process.env.NEXT_PUBLIC_BACKEND_BASE_PATH = '/document-engine';
+    setLocation('https://neev.example.com/document-engine/docs/abc/');
+    useConfig.mockReturnValue({
+      data: { COLLABORATION_WS_URL: 'wss://collab.example.com/ws/' },
+    });
+
+    const { result } = renderHook(() => useCollaborationUrl(ROOM));
+
+    expect(result.current).toBe(`wss://collab.example.com/ws/?room=${ROOM}`);
+  });
+});
