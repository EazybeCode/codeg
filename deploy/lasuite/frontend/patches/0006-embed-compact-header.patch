@@ -1,9 +1,56 @@
 import { PropsWithChildren } from 'react';
 import { css } from 'styled-components';
 
+import { isEmbedded } from '@/core/embed';
+
 import { Box, BoxType } from './Box';
 import { Card } from './Card';
 
+/**
+ * Embedded, this bar is taken out of the vertical flow entirely.
+ *
+ * Lowering `min-height` did almost nothing, because the height was never the
+ * minimum: the row measures 66px from its own contents — a 42px button inside
+ * `sm` padding — and that 66px is blank space above the title of every
+ * document, on top of the host's own chrome. Standalone the bar is the only
+ * thing up there and its height is the right price; in a frame it is a second
+ * header charged for a handful of buttons.
+ *
+ * So in a frame it becomes a zero-height overlay pinned to the top right. The
+ * buttons are unmoved and still clickable; what goes is the empty row they
+ * were sitting in. `pointer-events` is off on the strip and back on for its
+ * contents, so the invisible band cannot swallow a click meant for the title
+ * underneath it, and `DocHeader` reserves the width it covers so the two never
+ * overlap at narrow sizes.
+ */
+const EMBED_FLOATING_STYLES = css`
+  position: sticky;
+  top: 0;
+  left: 0;
+  right: 0;
+  width: 100%;
+  height: 0;
+  min-height: 0;
+  overflow: visible;
+  justify-content: flex-end;
+  align-items: flex-start;
+  z-index: 10;
+  isolation: isolate;
+  pointer-events: none;
+
+  /* The scrim belongs to a full-height bar; there is no longer one to scrim. */
+  &::before {
+    content: none;
+  }
+
+  > * {
+    position: relative;
+    z-index: 1;
+    pointer-events: auto;
+    margin: 4px 8px 0 0;
+  }
+`;
+
 const FLOATING_STYLES = css`
   position: sticky;
   top: 0;
@@ -45,9 +92,9 @@ export const FloatingBar = ({
       $direction="row"
       $justify="space-between"
       $align="flex-start"
-      $padding="sm"
+      $padding={isEmbedded() ? 'none' : 'sm'}
       $css={css`
-        ${FLOATING_STYLES}
+        ${isEmbedded() ? EMBED_FLOATING_STYLES : FLOATING_STYLES}
         ${$css}
       `}
       {...props}
