# Environment for the embedded build. Copied to apps/impress/.env.local by
# build.sh, where it overrides upstream's .env.
#
# Every value here is a build-time constant: Next inlines NEXT_PUBLIC_* into the
# bundle. Changing any of them means rebuilding. What is deliberately NOT here is
# a host — see NEXT_PUBLIC_API_ORIGIN below.

# Empty on purpose, and this is the whole reason one artifact serves every
# environment. Upstream falls back to window.location.origin when this is unset,
# so the built bundle resolves its own origin at runtime. Production HTTPS and a
# loopback test both work from the same files, with no origin baked in.
#
# It keeps its upstream meaning: an origin, scheme and host only. The path
# prefix goes in NEXT_PUBLIC_BACKEND_BASE_PATH, not here.
NEXT_PUBLIC_API_ORIGIN=

# Where the static export is served. Next derives page routes and /_next/ asset
# URLs from it.
NEXT_PUBLIC_BASE_PATH=/document-engine

# Where the backend is reverse-proxied. Prefixes the REST base, the media URLs
# and the collaboration socket. Leading slash, no trailing slash.
#
# The backend must not add this prefix itself. Media URLs in particular are
# composed client-side as `${backendUrl()}${attachment.file}`, so the
# attachment-upload response has to keep returning a root-relative `/media/...`
# path or the result is /document-engine/document-engine/media/...
NEXT_PUBLIC_BACKEND_BASE_PATH=/document-engine

# Render the editor without Docs' own navigation, sharing and account chrome,
# which Neev already provides. Presentation only — see src/core/embed.ts.
NEXT_PUBLIC_EMBED=true

# No service worker. It registers at the root scope, so it would take over
# caching for the whole host application rather than just this prefix. Setting
# this also skips workbox's InjectManifest, so no service-worker.js is emitted
# at all — the artifact cannot register one even by accident.
NEXT_PUBLIC_SW_DEACTIVATED=true

# MIT core only. Excludes the optional @blocknote/xl-* modules.
NEXT_PUBLIC_PUBLISH_AS_MIT=true
