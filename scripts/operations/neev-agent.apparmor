# Scoped AppArmor profile for the Neev native-agent container.
#
# Retains Docker's default hardening (no writes to sensitive /proc and /sys, no raw
# firmware/kcore/sysrq, ptrace/signal confined to this profile) but — unlike the
# docker-default profile, which `deny mount,` — grants ONLY the four mount operations
# the credential/sandbox path actually needs. Everything else about mount stays
# denied by AppArmor default-deny (there is no blanket `mount,`).
#
# Pairs with: default Docker seccomp (kept; `cryptsetup open --disable-keyring`
# avoids the kernel keyring), cap set {CHOWN,DAC_OVERRIDE,SETGID,SETUID,SETPCAP,
# NET_ADMIN,SYS_ADMIN,MKNOD}, explicit loop/mapper devices + a device-cgroup rule for
# the device-mapper major.
#
# Install (root, on the host):   apparmor_parser -r -W /etc/apparmor.d/neev-agent
# Use:                           docker run --security-opt apparmor=neev-agent ...

#include <tunables/global>

profile neev-agent flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # ---- Docker-default hardening (writes to sensitive kernel interfaces denied) ----
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s]}*/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # ---- The ONLY mounts Neev is allowed to perform ----
  # 1. the decrypted LUKS ext4 at each credential store entry's mount dir
  mount fstype=ext4 options=(rw, nodev, nosuid, noexec) -> /var/lib/neev-supervisor/credentials/*/mount/,
  # 2. make the propagation of the sandbox mount namespace private (ns prelude)
  mount options=(rw, rprivate) -> /,
  # 3. a private /proc for the sandbox pid namespace (unshare --mount-proc)
  mount fstype=proc -> /proc/,
  # 4. bind the credential volume onto the run's private, lane-traversable HOME
  mount options=(rw, rbind) /var/lib/neev-supervisor/credentials/*/mount/ -> /data/agents/run-*/home/,
  # 5. per-slot network-namespace management for the runtime egress bootstrap.
  #    `ip netns add` self-binds /run/netns, makes it shared, then binds the process
  #    net namespace into it; the guest/proxy netns setup uses these.
  mount options=(rw, bind) /run/netns/ -> /run/netns/,
  mount options=(rw, shared) -> /run/netns/,
  mount options=(rw, rshared) -> /run/netns/,
  mount options=(rw, bind) /proc/*/ns/net -> /run/netns/*,
  # ip_forward is provisioned by `docker --sysctl` (not written here); the profile
  # deliberately does NOT allow /proc/sys writes.

  ptrace (trace,read,tracedby,readby) peer=neev-agent,
  signal (receive,send) peer=neev-agent,
}
