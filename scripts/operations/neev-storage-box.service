[Unit]
Description=Copy and verify Neev originals on the Hetzner Storage Box (never deletes)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/neev-storage-box/neev_storage_box.py --config /etc/neev-storage-box/config.json replicate
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/neev-storage-box
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
