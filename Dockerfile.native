FROM node:22.23.2-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS frontend

WORKDIR /app

RUN corepack enable \
    && corepack prepare pnpm@11.9.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc LICENSE ./
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY src/ ./src/
COPY public/ ./public/
COPY components.json next-env.d.ts next.config.ts postcss.config.mjs tsconfig.json ./

# Dependency lifecycle hooks stay disabled. This is the inspected root hook that
# installs Monaco's static assets, followed by the existing static-export build.
RUN pnpm run postinstall \
    && pnpm build \
    && install -D -m 0644 LICENSE /usr/share/doc/neev/LICENSE \
    && install -D -m 0644 node_modules/@blocknote/core/LICENSE /usr/share/doc/neev/blocknote-core-LICENSE \
    && install -D -m 0644 node_modules/@blocknote/react/LICENSE /usr/share/doc/neev/blocknote-react-LICENSE \
    && install -D -m 0644 node_modules/@blocknote/shadcn/LICENSE /usr/share/doc/neev/blocknote-shadcn-LICENSE \
    && printf '%s\n' \
      'Bundled frontend attribution' \
      '@blocknote/core 0.54.2 — https://github.com/TypeCellOS/BlockNote/tree/main/packages/core' \
      '@blocknote/react 0.54.2 — https://github.com/TypeCellOS/BlockNote/tree/main/packages/react' \
      '@blocknote/shadcn 0.54.2 — https://github.com/TypeCellOS/BlockNote/tree/main/packages/shadcn' \
      > /usr/share/doc/neev/THIRD_PARTY_NOTICES.txt

FROM rust:1.98.1-slim-bookworm@sha256:ebd900bae66fd508b466cef82d64a83a5fb34682e4c8b2797a42908bddc95a57 AS backend

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      build-essential \
      ca-certificates \
      libssl-dev \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_BUILD_JOBS=1 \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_RELEASE_DEBUG=0

WORKDIR /app/src-tauri

COPY src-tauri/Cargo.toml src-tauri/Cargo.lock src-tauri/build.rs ./
COPY src-tauri/src/ ./src/
COPY src-tauri/resources/ ./resources/
COPY src-tauri/experts/ ./experts/
COPY src-tauri/science/ ./science/
COPY src-tauri/vendor/sacp-tokio/ ./vendor/sacp-tokio/

RUN cargo build \
      --locked \
      --release \
      --no-default-features \
      --bin neev-server \
      --bin neev-content-verify

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS native

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      ca-certificates \
      libgcc-s1 \
      libssl3 \
      libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o 0 -g 0 -m 0755 /app /app/web /usr/share/doc/neev \
    && install -d -o 65532 -g 65532 -m 0700 /data/documents

COPY --from=backend --chown=0:0 /app/src-tauri/target/release/neev-server /usr/local/bin/neev-server
COPY --from=backend --chown=0:0 /app/src-tauri/target/release/neev-content-verify /usr/local/bin/neev-content-verify
COPY --from=frontend --chown=0:0 /app/out/ /app/web/
COPY --from=frontend --chown=0:0 /usr/share/doc/neev/ /usr/share/doc/neev/

RUN chmod 0555 /usr/local/bin/neev-server /usr/local/bin/neev-content-verify \
    && find /app/web /usr/share/doc/neev -type d -exec chmod 0555 {} + \
    && find /app/web /usr/share/doc/neev -type f -exec chmod 0444 {} +

ENV NEEV_RUNTIME_ENABLED=false \
    NEEV_STATIC_ROOT=/app/web \
    NEEV_DOCUMENT_ROOT=/data/documents \
    NEEV_BIND=0.0.0.0:3080

STOPSIGNAL SIGINT
USER 65532:65532
CMD ["/usr/local/bin/neev-server"]
